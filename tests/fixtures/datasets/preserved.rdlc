<?xml version="1.0"?>
<r:Report xmlns:r="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:designer="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:x="urn:metadata">
  <r:DataSets><r:DataSet Name="Existing" x:keep="yes"><r:Fields>
    <r:Field Name="Known"><r:DataField>application_column</r:DataField><designer:TypeName>System.Int32</designer:TypeName></r:Field>
    <r:Field Name="Calculated"><r:Value>=Fields!Known.Value + 1</r:Value></r:Field>
    <r:Field Name="Unknown"><r:DataField>money</r:DataField><designer:TypeName>Custom.Money</designer:TypeName></r:Field>
  </r:Fields><r:Query><r:DataSourceName>Untouched</r:DataSourceName><r:CommandText>SELECT untouched</r:CommandText></r:Query><!-- exact --><x:Metadata>opaque</x:Metadata></r:DataSet></r:DataSets>
  <r:ReportSections><r:ReportSection><r:Body><r:ReportItems></r:ReportItems><r:Height>2in</r:Height></r:Body><r:Width>6in</r:Width><r:Page/></r:ReportSection></r:ReportSections>
</r:Report>
