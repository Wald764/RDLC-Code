  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Image Name="Existing">
            <Source>Embedded</Source>
            <Value>logo</Value>
            <MIMEType>image/png</MIMEType>
            <Sizing>Fit</Sizing>
            <Top>0.25in</Top>
            <Left>0.25in</Left>
            <Height>0.5in</Height>
            <Width>1.5in</Width>
          </Image>
        </ReportItems>
        <Height>1.5in</Height>
      </Body>
      <Width>6in</Width>
      <Page>
        <PageHeight>11in</PageHeight>
        <PageWidth>8.5in</PageWidth>
        <LeftMargin>1in</LeftMargin>
        <TopMargin>1in</TopMargin>
        <RightMargin>1in</RightMargin>
        <BottomMargin>1in</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>
  <EmbeddedImages>
    <EmbeddedImage Name="logo">
      <MIMEType>image/png</MIMEType>
      <ImageData>iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAGUlEQVR42mP438DwnxLMMGrAqAGjBgwXAwCAAH4f4cqr1QAAAABJRU5ErkJggg==</ImageData>
    </EmbeddedImage>
