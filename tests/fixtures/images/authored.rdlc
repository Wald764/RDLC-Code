<?xml version="1.0" encoding="utf-8"?>
<!-- Synthetic image fixture: authored definitions, one item per Sizing mode, unknown and foreign content; MIT; MS-RDL 2.12, 2.305, 2.306 -->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:x="urn:rdlc-code:extension">
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Image Name="LogoAutoSize">
            <Source>Embedded</Source>
            <Value>logo</Value>
            <MIMEType>image/png</MIMEType>
            <Sizing>AutoSize</Sizing>
            <Top>0.25in</Top>
            <Left>0.25in</Left>
            <Height>0.5in</Height>
            <Width>1.5in</Width>
          </Image>
          <Image Name="LogoFit">
            <Source>Embedded</Source>
            <Value>logo</Value>
            <MIMEType>image/png</MIMEType>
            <Sizing>Fit</Sizing>
            <Top>0.9in</Top>
            <Left>0.25in</Left>
            <Height>0.5in</Height>
            <Width>1.5in</Width>
          </Image>
          <Image Name="PhotoFitProportional">
            <Source>Embedded</Source>
            <Value>photo</Value>
            <MIMEType>image/jpeg</MIMEType>
            <Sizing>FitProportional</Sizing>
            <Top>1.55in</Top>
            <Left>0.25in</Left>
            <Height>0.5in</Height>
            <Width>1.5in</Width>
          </Image>
          <Image Name="PhotoClip">
            <Source>Embedded</Source>
            <Value>photo</Value>
            <MIMEType>image/jpeg</MIMEType>
            <Sizing>Clip</Sizing>
            <Top>2.2in</Top>
            <Left>0.25in</Left>
            <Height>0.5in</Height>
            <Width>1.5in</Width>
          </Image>
          <Image Name="Tagged" x:flag="1">
            <Source>Embedded</Source>
            <Value>logo</Value>
            <MIMEType>image/png</MIMEType>
            <Sizing>Fit</Sizing>
            <Top>2.85in</Top>
            <Left>0.25in</Left>
            <Height>0.5in</Height>
            <Width>1.5in</Width>
            <FutureThing level="2">kept</FutureThing>
            <x:Opaque keep="1">preserve</x:Opaque>
          </Image>
        </ReportItems>
        <Height>3.5in</Height>
      </Body>
      <Width>6in</Width>
      <Page>
        <PageHeight>11in</PageHeight>
        <PageWidth>8.5in</PageWidth>
        <LeftMargin>1in</LeftMargin>
        <TopMargin>1in</TopMargin>
        <RightMargin>1in</RightMargin>
        <BottomMargin>1in</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>
  <EmbeddedImages>
    <EmbeddedImage Name="logo">
      <MIMEType>image/png</MIMEType>
      <ImageData></ImageData>
    </EmbeddedImage>
    <EmbeddedImage Name="photo">
      <MIMEType>image/jpeg</MIMEType>
      <ImageData></ImageData>
    </EmbeddedImage>
    <EmbeddedImage Name="unused">
      <MIMEType>image/png</MIMEType>
      <ImageData></ImageData>
    </EmbeddedImage>
  </EmbeddedImages>
</Report>
