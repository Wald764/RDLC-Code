<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:ext="urn:rdlc-code:ext" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="Secret">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>SECRET_OPAQUE_CONNECTION</ConnectString>
      </ConnectionProperties>
      <ext:Credentials>SECRET_OPAQUE_CREDENTIALS</ext:Credentials>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Lookalike">
      <Fields>
        <Field Name="Real"><DataField>Real</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <ext:Field Name="Ghost"><ext:DataField>SECRET_OPAQUE_BINDING</ext:DataField></ext:Field>
      </Fields>
      <ext:Query><ext:CommandText>SECRET_OPAQUE_QUERY</ext:CommandText></ext:Query>
    </DataSet>
    <ext:DataSet Name="ForeignCollection">
      <ext:Fields><ext:Field Name="ForeignChild"/></ext:Fields>
    </ext:DataSet>
  </DataSets>
  <ext:DataSets>
    <ext:DataSet Name="ForeignRoot">
      <ext:Fields><ext:Field Name="ForeignNested"/></ext:Fields>
    </ext:DataSet>
  </ext:DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems><Textbox Name="Title"/></ReportItems>
        <Height>2in</Height>
      </Body>
      <Width>6.5in</Width>
      <Page>
        <PageHeight>11in</PageHeight>
        <PageWidth>8.5in</PageWidth>
        <LeftMargin>1in</LeftMargin>
        <RightMargin>1in</RightMargin>
        <TopMargin>1in</TopMargin>
        <BottomMargin>1in</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>
</Report>
