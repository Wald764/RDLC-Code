{
  "name": "rdlc-test-harness",
  "publisher": "rdlc-tests",
  "version": "0.0.0",
  "private": true,
  "main": "./drag-probe.cjs",
  "contributes": {
    "commands": [
      {
        "command": "rdlcTests.reportWorkspaceTrust",
        "title": "RDLC Test: Report Workspace Trust"
      },
      {
        "command": "rdlcTests.showNativeDrag",
        "title": "RDLC Test: Show Native Drag Probe"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "rdlcTests.nativeDrag",
          "name": "RDLC Native Drag Probe",
          "when": "rdlcTests.nativeDragEnabled"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "rdlcTests.sourceOnlyOpening",
        "displayName": "RDLC source-only opening test",
        "selector": [
          {
            "filenamePattern": "*.rdlc"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "rdlcTests.sessionInit",
        "displayName": "RDLC session initialization test",
        "selector": [
          {
            "filenamePattern": "*.rdlc"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "rdlcCode.historyProof",
        "displayName": "RDLC native history test",
        "selector": [
          {
            "filenamePattern": "*.rdlc"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "engines": {
    "vscode": "^1.142.0"
  }
}
