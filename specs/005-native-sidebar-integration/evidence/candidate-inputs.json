{
  "rules": {
    "version": 1,
    "included": [
      ".gitignore",
      ".node-version",
      ".prettierignore",
      ".prettierrc.json",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.json",
      "tsconfig.base.json",
      "eslint.config.ts",
      "packages/**",
      "apps/**",
      "scripts/**",
      "tests/**",
      "specs/**",
      ".github/**"
    ],
    "excluded": [
      "generated output roots: root dist/ and build/, packages/*/dist/, apps/*/dist|build/ and .angular caches",
      "dependency/tool roots: node_modules/, .git/, .vscode-test/, .opencode/",
      "feature evidence records: specs/005-native-sidebar-integration/evidence/",
      "test captures: tests/desktop/artifacts/",
      "generated artifacts and logs: *.vsix, *.log, *.trace.zip",
      "specs/005-native-sidebar-integration/tasks.md and specs/005-native-sidebar-integration/checklists/",
      "root narrative docs (README.md, CONTRIBUTING.md, LICENSE, THIRD_PARTY_NOTICES.md, docs/**) and vendor/** citations"
    ]
  },
