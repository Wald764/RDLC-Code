{
  "name": "rdlc-code",
  "displayName": "RDLC Code",
  "description": "Offline source-preserving RDLC report designer.",
  "publisher": "Wald764",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "icon": "media/rdlc-logo.png",
  "galleryBanner": {
    "color": "#17365A",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.142.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./build/extension.cjs",
  "activationEvents": [
    "onCustomEditor:rdlcCode.designer"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rdlcCode",
          "title": "RDLC Code",
          "icon": "media/rdlc-activity.svg"
        }
      ]
    },
    "views": {
      "rdlcCode": [
        {
          "id": "rdlcCode.structure",
          "name": "Report Structure"
        },
        {
          "id": "rdlcCode.data",
          "name": "Report Data"
        },
        {
          "id": "rdlcCode.components",
          "name": "Components"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rdlcCode.structure",
        "contents": "Open or create a report to begin.\n[New Report](command:rdlcCode.newReport)\n[Open Report](command:rdlcCode.sidebar.openReport)",
        "when": "!rdlcCode.hasReport"
      },
      {
        "view": "rdlcCode.data",
        "contents": "Open or create a report to begin.\n[Open Report](command:rdlcCode.sidebar.openReport)",
        "when": "!rdlcCode.hasReport"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rdlcCode.openSource",
          "when": "(view == rdlcCode.structure || view == rdlcCode.data) && rdlcCode.hasReport",
          "group": "navigation"
        },
        {
          "command": "rdlcCode.sidebar.filter",
          "when": "view == rdlcCode.components",
          "group": "navigation"
        },
        {
          "command": "rdlcCode.sidebar.clearFilter",
          "when": "view == rdlcCode.components && rdlcCode.componentsFiltered",
          "group": "navigation"
        },
        {
          "command": "rdlcCode.newReport",
          "when": "view == rdlcCode.structure",
          "group": "navigation"
        },
        {
          "command": "rdlcCode.sidebar.openReport",
          "when": "view == rdlcCode.structure",
          "group": "navigation"
        },
        {
          "command": "rdlcCode.sidebar.dataAddDataset",
          "when": "view == rdlcCode.data && rdlcCode.hasReport",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "rdlcCode.sidebar.properties",
          "when": "viewItem =~ /^rdlcCode\\.(body|editable)/",
          "group": "navigation@1"
        },
        {
          "command": "rdlcCode.sidebar.properties",
          "when": "viewItem =~ /^rdlcCode\\.(body|editable)/",
          "group": "inline"
        },
        {
          "command": "rdlcCode.sidebar.source",
          "when": "viewItem =~ /^rdlcCode\\.(body|editable|group|source|dataset|field)/",
          "group": "navigation"
        },
        {
          "command": "rdlcCode.sidebar.copy",
          "when": "viewItem =~ /^rdlcCode\\.body/",
          "group": "clipboard@1"
        },
        {
          "command": "rdlcCode.sidebar.cut",
          "when": "viewItem =~ /^rdlcCode\\.body/",
          "group": "clipboard@2"
        },
        {
          "command": "rdlcCode.sidebar.duplicate",
          "when": "viewItem =~ /^rdlcCode\\.body/",
          "group": "clipboard@3"
        },
        {
          "command": "rdlcCode.sidebar.table",
          "when": "viewItem =~ /\\.table$/",
          "group": "navigation@2"
        },
        {
          "command": "rdlcCode.sidebar.group",
          "when": "viewItem == rdlcCode.group",
          "group": "navigation@3"
        },
        {
          "command": "rdlcCode.sidebar.delete",
          "when": "view == rdlcCode.structure && viewItem =~ /^rdlcCode\\.(body|editable\\.table)/",
          "group": "destructive@1"
        },
        {
          "command": "rdlcCode.sidebar.dataEdit",
          "when": "view == rdlcCode.data && viewItem =~ /^rdlcCode\\.(dataset|field)$/",
          "group": "navigation@1"
        },
        {
          "command": "rdlcCode.sidebar.dataAddField",
          "when": "view == rdlcCode.data && viewItem == rdlcCode.dataset",
          "group": "navigation@2"
        },
        {
          "command": "rdlcCode.sidebar.dataRename",
          "when": "view == rdlcCode.data && viewItem =~ /^rdlcCode\\.(dataset|field)$/",
          "group": "navigation@3"
        },
        {
          "command": "rdlcCode.sidebar.dataDelete",
          "when": "view == rdlcCode.data && viewItem =~ /^rdlcCode\\.(dataset|field)$/",
          "group": "destructive@1"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "rdlcCode.designer",
        "displayName": "RDLC Designer",
        "selector": [
          {
            "filenamePattern": "*.rdlc"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "rdlcCode.sidebar.copy",
        "title": "RDLC Code: Copy"
      },
      {
        "command": "rdlcCode.sidebar.cut",
        "title": "RDLC Code: Cut"
      },
      {
        "command": "rdlcCode.sidebar.duplicate",
        "title": "RDLC Code: Duplicate"
      },
      {
        "command": "rdlcCode.sidebar.delete",
        "title": "RDLC Code: Delete"
      },
      {
        "command": "rdlcCode.sidebar.table",
        "title": "RDLC Code: Table Properties"
      },
      {
        "command": "rdlcCode.sidebar.group",
        "title": "RDLC Code: Group Properties"
      },
      {
        "command": "rdlcCode.sidebar.dataEdit",
        "title": "RDLC Code: Edit Data"
      },
      {
        "command": "rdlcCode.sidebar.dataAddField",
        "title": "RDLC Code: Add Field"
      },
      {
        "command": "rdlcCode.sidebar.dataRename",
        "title": "RDLC Code: Rename"
      },
      {
        "command": "rdlcCode.sidebar.dataDelete",
        "title": "RDLC Code: Delete"
      },
      {
        "command": "rdlcCode.sidebar.dataAddDataset",
        "title": "RDLC Code: New Dataset",
        "icon": "$(add)"
      },
      {
        "command": "rdlcCode.sidebar.openReport",
        "title": "RDLC Code: Open Report",
        "icon": "$(folder-opened)"
      },
      {
        "command": "rdlcCode.sidebar.activate",
        "title": "RDLC Code: Activate Report Item"
      },
      {
        "command": "rdlcCode.sidebar.properties",
        "title": "RDLC Code: Properties",
        "icon": "$(settings-gear)"
      },
      {
        "command": "rdlcCode.sidebar.source",
        "title": "RDLC Code: Code XML",
        "icon": "$(code)"
      },
      {
        "command": "rdlcCode.sidebar.filter",
        "title": "RDLC Code: Filter Components",
        "icon": "$(filter)"
      },
      {
        "command": "rdlcCode.sidebar.clearFilter",
        "title": "RDLC Code: Clear Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "rdlcCode.newReport",
        "title": "RDLC Code: New Report"
      },
      {
        "command": "rdlcCode.openDesigner",
        "title": "RDLC Code: Open Designer"
      },
      {
        "command": "rdlcCode.openSource",
        "title": "RDLC Code: Open Source"
      }
    ]
  },
  "dependencies": {
    "@rdlc/report-model": "workspace:*",
    "@rdlc/xml-parser": "workspace:*",
    "@rdlc/xml-serializer": "workspace:*",
    "@rdlc/validation": "workspace:*",
    "@rdlc/expressions": "workspace:*",
    "@rdlc/renderer": "workspace:*"
  }
}
